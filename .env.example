# ================================
# Odé AI Platform — Environment Variables
# ================================

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Odé AI Platform"

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ode_platform?schema=public"
DATABASE_SHADOW_URL="postgresql://postgres:password@localhost:5432/ode_platform_shadow?schema=public"

# Auth (Auth.js)
NEXTAUTH_SECRET=your-secret-key-min-32-chars-here-change-this
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=your-jwt-secret-min-32-chars-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AI Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o

# Redis
REDIS_URL=redis://localhost:6379

# Storage (S3-compatible)
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=ode-platform-files
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_PUBLIC_URL=https://files.ode-platform.com

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM="Odé AI <noreply@ode-platform.com>"

# Encryption
ENCRYPTION_KEY=32-byte-hex-key-here

# Super Admin seed
SUPER_ADMIN_EMAIL=admin@ode-platform.com
SUPER_ADMIN_PASSWORD=ChangeMe!2024
